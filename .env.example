# Supabase — Project Settings > API
# Public: safe to expose to the browser, used by the client-side Supabase client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Optional — sentry.io > Settings > Projects > (project) > Client Keys.
# Server-side (SENTRY_DSN) and browser-side (NEXT_PUBLIC_SENTRY_DSN) errors
# are reported here (metadata only, never document content). Left unset,
# Sentry.init() no-ops and nothing is sent. SENTRY_ORG/SENTRY_PROJECT/
# SENTRY_AUTH_TOKEN are only needed to upload source maps at build time —
# safe to leave unset too; the build just skips that step without them.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — the field-level confidence below which a field is flagged for
# human review, read server-side and enforced by approve_document() (also
# used, informationally, by the worker's own log output). Left unset,
# defaults to 0.9. Must be a number in (0, 1]; a malformed value falls back
# to the default rather than silently disabling the review gate.
REVIEW_CONFIDENCE_THRESHOLD=

# Required for the self-service invite flow only (src/app/settings/members) —
# every other request in this app is anon-key + RLS-scoped and never
# touches this. Never expose to the browser; see src/lib/supabase/admin.ts
# for exactly what it's used for and why.
SUPABASE_SERVICE_ROLE_KEY=

# Required for the invite flow only — the real deployed app's own base URL
# (no trailing slash), used to build the link in an invite email. Left
# unset, falls back to Railway's own auto-injected RAILWAY_PUBLIC_DOMAIN in
# a real deployment (nothing to configure there); set this explicitly for
# local dev/testing, or if RAILWAY_PUBLIC_DOMAIN isn't set (a non-Railway
# deployment). Example: https://your-app.example.com
SITE_URL=
