# Same Supabase project as the Next.js app, but this key bypasses RLS —
# only the worker should ever have it, never the browser or a Vercel
# serverless function's client-facing code path.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys — required by src/extraction/extract.ts.
ANTHROPIC_API_KEY=

# Only needed by scripts/seed-demo.mjs, never by the deployed worker itself
# (that script signs in as the real demo user, which needs the public
# anon key, not the service-role key above). Same value as the app's
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=

# Optional — sentry.io > Settings > Projects > (project) > Client Keys.
# Uncaught worker errors (metadata only, never document content) are
# reported here. Left unset, Sentry.init() no-ops and nothing is sent.
SENTRY_DSN=

# Optional — overrides the 500-cents/day default in src/claim.ts. See
# supabase/migrations/20260726000000_daily_cost_cap.sql for what actually
# enforces it (claim_next_document()); this is passed through as an RPC
# parameter, not read by the database directly.
DAILY_COST_CAP_CENTS=

# Optional — how many documents this worker process claims and processes
# at once. Defaults to 1 (unchanged behavior: one document at a time).
# claim_next_document() already serializes concurrent claims safely, so
# raising this is purely a throughput knob — but it also widens the daily
# cost cap's overshoot window proportionally (see src/index.ts's own
# comment for why). Keep it modest (2-5) unless a deployment's real
# document volume needs more than that.
WORKER_CONCURRENCY=

# Optional — overrides the 0.9 default in src/scoring/threshold.ts. Only
# feeds this worker's own log output (how many fields it flagged); the
# real enforcement is approve_document(), which the app resolves and
# passes in separately — set the same value on both services if you
# change it, or the worker's logs will describe a different threshold
# than the one actually gating approval.
REVIEW_CONFIDENCE_THRESHOLD=
