# Same Supabase project as the Next.js app, but this key bypasses RLS —
# only the worker should ever have it, never the browser or a Vercel
# serverless function's client-facing code path.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys — required by src/extraction/extract.ts.
ANTHROPIC_API_KEY=

# Only needed by scripts/seed-demo.mjs, never by the deployed worker itself
# (that script signs in as the real demo user, which needs the public
# anon key, not the service-role key above). Same value as the app's
# NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
